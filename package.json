{
  "name": "learningai-tutor",
  "private": true,
  "version": "2.0.0",
  "description": "Tutor: learn from your own documents with a grounded, voice-first AI study partner (Z.AI GLM + Deepgram), living visual study guides and adaptive review.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude './web/**' --exclude './data/**' server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --sourcemap --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e/smoke.mjs",
    "format": "prettier --write \"server/**/*.ts\" \"shared/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,tsx}\" docs/ARCHITECTURE.md",
    "format:check": "prettier --check \"server/**/*.ts\" \"shared/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,tsx}\"",
    "graphify:update": "graphify update .",
    "graphify:query": "graphify query",
    "graphify:path": "graphify path",
    "graphify:tree": "graphify tree --graph graphify-out/graph.json --output graphify-out/GRAPH_TREE.html --root . --label Tutor",
    "test:live": "tsx test/live/zai-live.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@tanstack/react-query": "^5.103.2",
    "better-sqlite3": "^12.10.0",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.1.1",
    "compression": "^1.8.1",
    "d3-force": "^3.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.6",
    "img-fx": "^0.5.1",
    "katex": "^0.18.9",
    "liquid-gooey": "^0.2.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.15.0",
    "metal-fx": "^2.0.11",
    "motion": "^13.4.4",
    "multer": "^2.1.1",
    "pdfjs-dist": "5.4.296",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.1.0",
    "thinking-orbs": "^0.3.2",
    "three": "^0.186.1",
    "voice-glow": "^0.2.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  }
}
