# Tutor v2 — copy to .env and fill in what you have.
# With no keys at all the app still runs end to end on an offline mock model
# and browser speech, which is handy for UI work and tests.

# ---------------------------------------------------------------- Z.AI (GLM)
# Brain of the tutor. Fast model = chat + live voice; smart model = background
# work, study-guide synthesis and "Deep think" mode.
ZAI_API_KEY=
# Pay-as-you-go endpoint (recommended; needs account balance, else error 1113).
# The GLM Coding Plan endpoint is https://api.z.ai/api/coding/paas/v4 — it
# serves Coding Plan quota, but Z.AI's plan terms restrict that quota to
# supported coding tools, so using it for this app is at the account owner's
# risk. Measured on it (peak hours): 1.5-4 s to first token, ~3 s more when
# tools are declared; short replies arrive in one burst.
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_FAST_MODEL=glm-5.3-flash
ZAI_SMART_MODEL=glm-5.3
# GLM-5.3-Flash is natively multimodal: used for OCR of scanned pages.
ZAI_VISION_MODEL=glm-5.3-flash
# Concurrent upstream requests per model role. Requests beyond this queue by
# priority (voice > chat > background > housekeeping). A 429 halves it
# automatically and it recovers on success. (A Lite Coding Plan took 6
# parallel requests without throttling in testing.)
ZAI_FAST_CONCURRENCY=3
ZAI_SMART_CONCURRENCY=2
ZAI_VISION_CONCURRENCY=1

# ---------------------------------------------------------------- Speech
# Deepgram: Flux streaming STT (with eager end-of-turn) + Aura-2 TTS.
# Without it, voice mode uses the browser's speech recognition and voices.
DEEPGRAM_API_KEY=
VOICE_STT_MODEL=flux-general-en
VOICE_STT_MULTILINGUAL_MODEL=nova-3
VOICE_TTS_VOICE=aura-2-thalia-en
VOICE_TTS_SAMPLE_RATE=24000
# Flux end-of-turn confidence; eager threshold starts replies speculatively.
VOICE_EOT_THRESHOLD=0.75
VOICE_EAGER_EOT_THRESHOLD=0.5
VOICE_MAX_SESSION_MINUTES=30

# ---------------------------------------------------------------- Search
# Serper (Google web + images, ~$1 per 1k). Without it, web search uses
# Wikipedia and images come from Wikimedia Commons (free, CC-licensed).
SERPER_API_KEY=

# ---------------------------------------------------------------- Server
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Comma-separated browser origins allowed to call the API / voice socket when
# the web app is hosted elsewhere (e.g. a CDN). Same-origin always works.
ALLOWED_ORIGINS=
UPLOAD_MAX_MB=60
USER_REQUESTS_PER_MINUTE=30
# Study-guide background sync: idle debounce and max unsynced messages.
GUIDE_DEBOUNCE_MS=12000
GUIDE_MAX_PENDING_MESSAGES=8
LOG_LEVEL=info

# Web build only: API origin when the SPA is served from a different host.
VITE_API_BASE=

# ---------------------------------------------------------------- Egress proxy
# Behind a corporate egress proxy: set HTTPS_PROXY (and NO_PROXY). Streaming
# STT WebSockets use it automatically; for REST calls (GLM, TTS, search) also
# set NODE_USE_ENV_PROXY=1 so Node's fetch honours it (Node >= 22.21).
# NODE_USE_ENV_PROXY=1
